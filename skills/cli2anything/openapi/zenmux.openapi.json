{
  "openapi": "3.1.0",
  "info": {
    "title": "ZenMux Observed Logs API",
    "version": "0.1.0",
    "description": "Observed OpenAPI contract for ZenMux log list/detail workflows. Endpoints are derived from public documentation and public frontend bundle evidence; use only with an authorized ZenMux account/API key."
  },
  "servers": [
    {
      "url": "https://zenmux.ai"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
