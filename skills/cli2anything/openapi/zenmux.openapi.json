      "consoleCookie": {
        "type": "apiKey",
        "in": "header",
        "name": "Cookie",
        "description": "Authenticated ZenMux console cookie header. Required by dashboard-derived log endpoints when the backend enforces CSRF/session checks."
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-XSRF-TOKEN",
        "description": "Console CSRF token header observed from the public frontend bundle. Axios reads the XSRF-TOKEN cookie and sends it as X-XSRF-TOKEN. The SDK can be configured with ZENMUX_CSRF_HEADER if ZenMux changes this header name."
      }
    },
    "parameters": {
      "ApiVersionHeader": {
        "name": "x-api-version",
        "in": "header",
