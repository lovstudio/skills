  {
   "fromF": 0,
   "toF": 29,
   "text": "考研还考了五次"
  },
  {
   "fromF": 29,
   "toF": 44,
   "text": "对不对"
  },
  {
   "fromF": 44,
   "toF": 85,
   "text": "见了那么多投资人 对吧"
  },
  {
   "fromF": 85,
   "toF": 131,
   "text": "所以我对很多人说"
  },
  {
   "fromF": 131,
   "toF": 166,
   "text": "我说你别创业对吧"
  },
  {
   "fromF": 166,
   "toF": 210,
   "text": "我觉得创业确实不是人创的"
  },
  {
   "fromF": 210,
   "toF": 243,
   "text": "就是我放过我的人生了"
  },
  {
   "fromF": 243,
   "toF": 282,
   "text": "所以我也在躺"
  },
  {
   "fromF": 282,
   "toF": 309,
   "text": "我这是真躺平"
  },
  {
   "fromF": 332,
   "toF": 386,
   "text": "最近比较热门的一个话题"
  },
  {
   "fromF": 386,
   "toF": 452,
   "text": "人生是一个巨大的事与愿违"
  },
  {
   "fromF": 452,
   "toF": 524,
   "text": "你对这个主题怎么看"
  },
  {
   "fromF": 524,
   "toF": 577,
   "text": "我跟我的AI聊天"
  },
  {
   "fromF": 577,
   "toF": 625,
   "text": "然后我让他给我规划"
  },
  {
   "fromF": 625,
   "toF": 676,
   "text": "一条我的成长路线"
  },
  {
   "fromF": 676,
   "toF": 736,
   "text": "后来AI理解之后"
  },
  {
   "fromF": 736,
   "toF": 800,
   "text": "给了我的策略"
  },
  {
   "fromF": 800,
   "toF": 871,
   "text": "然后它整体的命名"
  },
  {
   "fromF": 871,
   "toF": 919,
   "text": "就是叫奥德赛之旅"
  },
  {
   "fromF": 941,
   "toF": 985,
   "text": "手工川的奥德赛之旅"
  },
  {
   "fromF": 985,
   "toF": 1070,
   "text": "而且我确实觉得每个人这辈子"
  },
  {
   "fromF": 1070,
   "toF": 1132,
   "text": "就是他的唯一的使命"
  },
  {
   "fromF": 1132,
   "toF": 1200,
   "text": "其实就是找到自我嘛对吧"
  },
  {
   "fromF": 1200,
   "toF": 1213,
   "text": "见天地"
  },
  {
   "fromF": 1213,
   "toF": 1226,
   "text": "见众生"
  },
  {
   "fromF": 1226,
   "toF": 1246,
   "text": "见自我"
  },
  {
   "fromF": 1246,
   "toF": 1277,
   "text": "我觉得我们所有人的"
  },
  {
   "fromF": 1277,
   "toF": 1319,
   "text": "宿命最终都是一样的"
  },
  {
   "fromF": 1319,
   "toF": 1391,
   "text": "只不过途径不一样"
  },
  {
   "fromF": 1391,
   "toF": 1423,
   "text": "路径不一样"
  },
  {
   "fromF": 1441,
   "toF": 1469,
   "text": "终点是一样的"
  },
  {
   "fromF": 1469,
   "toF": 1506,
   "text": "我以前挺想成为谁的"
  },
  {
   "fromF": 1506,
   "toF": 1532,
   "text": "比如说成为乔布斯"
  },
  {
   "fromF": 1532,
   "toF": 1564,
   "text": "下一个乔布斯"
  },
  {
   "fromF": 1564,
   "toF": 1599,
   "text": "下一个张一鸣"
  },
  {
   "fromF": 1599,
   "toF": 1636,
   "text": "下一个马斯克"
  },
  {
   "fromF": 1636,
   "toF": 1679,
   "text": "我都有想过"
  },
  {
   "fromF": 1679,
   "toF": 1702,
   "text": "真的都有想过"
  },
  {
   "fromF": 1702,
   "toF": 1748,
   "text": "因为以前太想成功了嘛"
  },
  {
   "fromF": 1748,
   "toF": 1789,
   "text": "你就会想有没有什么捷径"
  },
  {
   "fromF": 1789,
   "toF": 1854,
   "text": "希望有一个样本可以抄"
  },
  {
   "fromF": 1854,
   "toF": 1905,
   "text": "但是我后来有意识到"
  },
  {
   "fromF": 1905,
   "toF": 1986,
   "text": "一个更深层次的问题"
  },
  {
   "fromF": 1986,
   "toF": 2003,
   "text": "你想赚钱"
  },
  {
   "fromF": 2003,
   "toF": 2032,
   "text": "每个人都想赚钱"
  },
  {
   "fromF": 2032,
   "toF": 2100,
   "text": "但是你不能只为了赚钱去赚钱"
  },
  {
   "fromF": 2100,
   "toF": 2124,
   "text": "你只为了赚钱"
  },
  {
   "fromF": 2124,
   "toF": 2174,
   "text": "你会失去所有的钱"
  }
 ]
